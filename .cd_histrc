#
# ~/.cd_histrc
#

# Colors (0 - 255)
CD_HIST_FILE="${HOME}/.cd_history"
CD_HIST_LIST_COLOR=242
CD_HIST_NEW_COLOR=8
CD_HIST_SYMBOL='*'
CD_HIST_SYMBOL_COLOR=2

if [[ -r $CD_HIST_FILE ]]; then
    mapfile -t cd_hist < "$CD_HIST_FILE"
else
    cd_hist=()
fi
cd_hist_current=$(( ${#cd_hist[@]} - 1 ))
(( cd_hist_current < 0 )) && cd_hist_current=0
scroll_up=1

# called from the PROMPT_COMMAND
update-cd-hist() {
    local cur_dir
    scroll_up=1
    cur_dir="$(pwd)" || return

    # History is empty, save current directory
    if (( ${#cd_hist[@]} == 0 )); then
        cd_hist+=("$cur_dir")
        return
    fi

    # Switch index to previous history entry
    if \
        (( cd_hist_current > 0 )) \
        && [[ "${cur_dir}" == "${cd_hist[cd_hist_current - 1]}" ]]
    then
        (( cd_hist_current -= 1 ))
        return
    fi

    # Switch index to next history entry
    if \
        (( cd_hist_current + 1 < ${#cd_hist[@]} )) \
        && [[ "${cur_dir}" == "${cd_hist[cd_hist_current + 1]}" ]]
    then
        (( cd_hist_current += 1 ))
        return
    fi

    # New directory is neither adjacent nor current
    if [[ "${cur_dir}" != "${cd_hist[cd_hist_current]}" ]]; then
        # Copy last entry to the end if not the same
        if [[ "${cd_hist[cd_hist_current]}" != "${cd_hist[-1]}" ]]; then
            cd_hist+=("${cd_hist[cd_hist_current]}")
        fi
        # Add new history entry
        cd_hist+=("$cur_dir")

        # Remove duplicates leaving the last entry
        local tmp_dir
        local -a tmp
        declare -A seen

        # Find last duplicate by traversing in reverse
        for (( i = ${#cd_hist[@]} - 1; i >= 0; i-- )); do
            tmp_dir="${cd_hist[i]}"
            if [[ -n $tmp_dir && ! -v 'seen[${tmp_dir}]' ]]; then
                tmp+=("$tmp_dir")
                seen["$tmp_dir"]=1
            fi
        done

        # Revert it back into cd_hist
        cd_hist=()
        for (( i = ${#tmp[@]} - 1; i >= 0; i-- )); do
            cd_hist+=("${tmp[i]}")
        done

        # Set current index to the last entry
        (( cd_hist_current = ${#cd_hist[@]} - 1 ))

        return
    fi
}

show-inline() {
    printf '\033[s' # save current cursor position
    printf '\033[%sC' "$(( PS1_LEN + 6 ))" # move the cursor forward n columns
    printf '\033[2K' # clear entire line
    printf '\033[38;5;%sm' "$CD_HIST_NEW_COLOR" # foreground color black
    printf '%s' "$*"
    printf '\033[0m' # reset color
    printf '\033[K' # clear from cursor to the end of the line
    printf '\033[u' # restore saved cursor position
}

show-above() {
    printf '\033[s' # save current cursor position
    if (( scroll_up )); then
        printf '\033[S' # scroll up
        scroll_up=0
    fi
    printf '\033[A' # move the cursor up one line
    printf '\033[2K' # clear entire line
    printf '\033[38;5;%sm' "$CD_HIST_NEW_COLOR" # foreground color black
    printf '%s' "$*"
    printf '\033[0m' # reset color
    printf '\033[K' # clear from cursor to the end of the line
    printf '\033[u' # restore saved cursor position
}

show-current() {
    (( ${#cd_hist[@]} )) || return
    # PS1_LEN is set in the PROMPT_COMMAND
    local cur_dir="${cd_hist[cd_hist_current]/$HOME/\~}"
    if [[ -n "${PS1_LEN:-}" ]]; then
        show-inline "$cur_dir"
    else
        show-above "$cur_dir"
    fi
}

# Change to previous directory in cd history with Alt-9 <(>
cd-hist-prev() {
    (( ${#cd_hist[@]} > 1 )) || return
    local target offset=1 wrap=0
    while true; do
        if (( cd_hist_current - offset < 0 )); then
            (( ++wrap > 1 )) && return
            (( offset -= ${#cd_hist[@]} ))
        fi
        target="${cd_hist[cd_hist_current - offset]}"
        if cd -- "$target" 2>/dev/null; then
            (( cd_hist_current -= offset ))
            show-current
            break
        fi
        (( ++offset ))
    done
}
bind -m vi-command -x '"\e9": cd-hist-prev'
bind -m vi-insert  -x '"\e9": cd-hist-prev'

# Change to next directory in cd history with Alt-0 <)>
cd-hist-next() {
    (( ${#cd_hist[@]} > 1 )) || return
    local target offset=1 wrap=0
    while true; do
        if (( cd_hist_current + offset >= ${#cd_hist[@]} )); then
            (( ++wrap > 1 )) && return
            (( offset -= ${#cd_hist[@]} ))
        fi
        target="${cd_hist[cd_hist_current + offset]}"
        if cd -- "$target" 2>/dev/null; then
            (( cd_hist_current += offset ))
            show-current
            break
        fi
        (( ++offset ))
    done
}
bind -m vi-command -x '"\e0": cd-hist-next'
bind -m vi-insert  -x '"\e0": cd-hist-next'

# Display history with Alt-8 <*>
show-cd-hist() {
    (( ${#cd_hist[@]} )) || return
    local start end idx
    (( start = cd_hist_current - 10 ))
    (( start < 0 )) && start=0
    (( end = cd_hist_current + 10 ))
    (( end > ${#cd_hist[@]} )) && (( end = ${#cd_hist[@]} ))
    for (( idx = start; idx < end; ++idx )); do
        printf '\033[38;5;%sm' "$CD_HIST_LIST_COLOR" # foreground color black
        printf '%s' "${cd_hist[idx]/$HOME/\~}"
        printf '\033[0m' # reset color
        if (( idx == cd_hist_current )); then
            printf '\033[38;5;%sm %s\033[0m' "$CD_HIST_SYMBOL_COLOR" "$CD_HIST_SYMBOL"
        fi
        printf '\n'
    done
}
bind -m vi-command -x '"\e8": show-cd-hist'
bind -m vi-insert  -x '"\e8": show-cd-hist'


# vim: ft=sh
