#
# ~/.cd_histrc
#

# Colors (0 - 255)
CD_HIST_LIST_COLOR=8
CD_HIST_SYMBOL='→'
CD_HIST_SYMBOL_COLOR=2
CD_HIST_REL_NUM_COLOR=59

SAVED_READLINE_LINE=
SAVED_READLINE_POINT=

cd_hist=(
    '/home/anton/.config/qtile'
    '/home/anton/.config/vim'
    '/home/anton/code'
)

cd_hist_current=$(( ${#cd_hist[@]} - 1 ))
(( cd_hist_current < 0 )) && cd_hist_current=0

# called from the PROMPT_COMMAND
update-cd-hist() {
    local cur_dir
    cur_dir="$(pwd)" || return

    # History is empty, save current directory
    if (( ${#cd_hist[@]} == 0 )); then
        cd_hist+=("$cur_dir")
        return
    fi

    # Switch index to previous history entry
    if \
        (( cd_hist_current > 0 )) \
        && [[ "${cur_dir}" == "${cd_hist[cd_hist_current - 1]}" ]]
    then
        (( cd_hist_current -= 1 ))
        return
    fi

    # Switch index to next history entry
    if \
        (( cd_hist_current + 1 < ${#cd_hist[@]} )) \
        && [[ "${cur_dir}" == "${cd_hist[cd_hist_current + 1]}" ]]
    then
        (( cd_hist_current += 1 ))
        return
    fi

    # New directory is neither adjacent nor current
    if [[ "${cur_dir}" != "${cd_hist[cd_hist_current]}" ]]; then
        # Copy last entry to the end if not the same
        if [[ "${cd_hist[cd_hist_current]}" != "${cd_hist[-1]}" ]]; then
            cd_hist+=("${cd_hist[cd_hist_current]}")
        fi
        # Add new history entry
        cd_hist+=("$cur_dir")

        # Remove duplicates leaving the last entry
        local tmp_dir
        local -a tmp
        declare -A seen

        # Find last duplicate by traversing in reverse
        for (( i = ${#cd_hist[@]} - 1; i >= 0; i-- )); do
            tmp_dir="${cd_hist[i]}"
            if [[ -n $tmp_dir && ! -v 'seen[${tmp_dir}]' ]]; then
                tmp+=("$tmp_dir")
                seen["$tmp_dir"]=1
            fi
        done

        # Revert it back into cd_hist
        cd_hist=()
        for (( i = ${#tmp[@]} - 1; i >= 0; i-- )); do
            cd_hist+=("${tmp[i]}")
        done

        # Set current index to the last entry
        (( cd_hist_current = ${#cd_hist[@]} - 1 ))

        return
    fi
}

renew-line() {
    printf '\033[2K' # clear entire line
    printf '\033[1A' # move the cursor up one line
    printf '\033[2K' # clear entire line
    if [[ -n $SAVED_READLINE_LINE ]]; then
        READLINE_LINE="$SAVED_READLINE_LINE"
        READLINE_POINT="$SAVED_READLINE_POINT"
        SAVED_READLINE_LINE=''
        SAVED_READLINE_POINT=''
    fi
}
bind -m vi-command -x '"\e\"": renew-line'
bind -m vi-insert  -x '"\e\"": renew-line'

# Change to previous directory in cd history with Alt-9 <(>
# If command line contains a single number, use it as offset
cd-hist-prev() {
    (( ${#cd_hist[@]} > 1 )) || return
    local target offset=1 wrap=0
    if [[ $READLINE_LINE =~ ^[0-9]+$ ]]; then
        if (( READLINE_LINE <= cd_hist_current )); then
            offset="$READLINE_LINE"
        else
            READLINE_LINE=''
            return 1
        fi
    else
        SAVED_READLINE_LINE="$READLINE_LINE"
        SAVED_READLINE_POINT="$READLINE_POINT"
    fi
    READLINE_LINE=''
    while true; do
        if (( cd_hist_current - offset < 0 )); then
            # Prevents endless loop in case all the directories are invalid
            (( ++wrap > 1 )) && return
            (( offset -= ${#cd_hist[@]} ))
        fi
        target="${cd_hist[cd_hist_current - offset]}"
        if cd -- "$target" 2>/dev/null; then
            (( cd_hist_current -= offset ))
            break
        fi
        (( ++offset ))
    done
}
bind -m vi-command -x '"\e<": cd-hist-prev'
bind -m vi-insert  -x '"\e<": cd-hist-prev'
bind -m vi-command    '"\e,": "\e<\C-m\e\e\""'
bind -m vi-insert     '"\e,": "\e<\C-m\e\""'

# Change to next directory in cd history with Alt-0 <)>
# If command line contains a single number, use it as offset
cd-hist-next() {
    (( ${#cd_hist[@]} > 1 )) || return
    local target offset=1 wrap=0
    if [[ $READLINE_LINE =~ ^[0-9]+$ ]]; then
        if (( READLINE_LINE < ${#cd_hist[@]} - cd_hist_current )); then
            offset="$READLINE_LINE"
        else
            READLINE_LINE=''
            return 1
        fi
    else
        SAVED_READLINE_LINE="$READLINE_LINE"
        SAVED_READLINE_POINT="$READLINE_POINT"
    fi
    READLINE_LINE=''
    while true; do
        if (( cd_hist_current + offset >= ${#cd_hist[@]} )); then
            # Prevents endless loop in case all the directories are invalid
            (( ++wrap > 1 )) && return
            (( offset -= ${#cd_hist[@]} ))
        fi
        target="${cd_hist[cd_hist_current + offset]}"
        if cd -- "$target" 2>/dev/null; then
            (( cd_hist_current += offset ))
            break
        fi
        (( ++offset ))
    done
}
bind -m vi-command -x '"\e>": cd-hist-next'
bind -m vi-insert  -x '"\e>": cd-hist-next'
bind -m vi-command    '"\e.": "\e>\C-m\e\e\""'
bind -m vi-insert     '"\e.": "\e>\C-m\e\""'

# Display history with Alt-8 <*>
show-cd-hist() {
    (( ${#cd_hist[@]} )) || return
    local start end idx rel_num
    (( start = cd_hist_current - 10 ))
    (( start < 0 )) && start=0
    (( end = cd_hist_current + 10 ))
    (( end > ${#cd_hist[@]} )) && (( end = ${#cd_hist[@]} ))
    for (( idx = start; idx < end; ++idx )); do
        printf '\033[1;38;5;%sm' "$CD_HIST_REL_NUM_COLOR"
        rel_num=$(( cd_hist_current - idx ))
        printf '%2d' $(( rel_num < 0 ? -rel_num : rel_num ))
        if (( idx == cd_hist_current )); then
            printf '\033[38;5;%sm %s\033[0m' "$CD_HIST_SYMBOL_COLOR" "$CD_HIST_SYMBOL"
        else
            printf '  '
        fi
        printf \
            '\033[1;38;5;%sm %s\033[0m\n' \
            "$CD_HIST_LIST_COLOR"         \
            "${cd_hist[idx]/$HOME/\~}"
    done
}
bind -m vi-command -x '"\e;": show-cd-hist'
bind -m vi-insert  -x '"\e;": show-cd-hist'


# vim: ft=sh
